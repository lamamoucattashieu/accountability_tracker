# Copy to .env (gitignored, never committed) and replace every value.
# Passwords and secrets: letters and digits only, at least 16 characters, with upper case,
# lower case and digits (SQL Server's rules; no URL-encoding and no compose "$" problems).

# SQL Server's administrator: used by db-init and by the tests, never by the services.
MSSQL_SA_PASSWORD=ChangeMeSaPassword123
# Each service's own database login (created by db/init.sql).
CHECKINS_DB_PASSWORD=ChangeMeCheckinsPassword123
POINTS_DB_PASSWORD=ChangeMePointsPassword123
# Shared by both services: signs and verifies access tokens.
AUTH_TOKEN_SECRET=ChangeMeTokenSecretAtLeast16Chars
# Shared by both services: proves an /internal/... call comes from the other service.
INTERNAL_API_KEY=ChangeMeInternalKeyAtLeast16Chars

# Tests only (run from the host): the compose SQL Server as sa, on its master database.
TEST_DATABASE_ADMIN_URL=mssql+pymssql://sa:ChangeMeSaPassword123@localhost:1433/master

# Optional: the commit baked into the images and shown by /health (default "dev").
# GIT_SHA=
